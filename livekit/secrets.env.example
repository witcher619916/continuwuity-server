# Template for secrets.enc.env - from the repo root, fill in and encrypt:
#   cp livekit/secrets.env.example livekit/secrets.env
#   sops encrypt livekit/secrets.env > livekit/secrets.enc.env
#   rm livekit/secrets.env
#
# Generate a key/secret pair with:
#   docker run --rm livekit/livekit-server generate-keys
LIVEKIT_KEY=<LIVEKIT_API_KEY>
LIVEKIT_SECRET=<LIVEKIT_API_SECRET>
# The VPS's Cloudflare Mesh IP
VPS_MESH_IP=<VPS_MESH_IP>
