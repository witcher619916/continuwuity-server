# Template for secrets.enc.env - from the repo root, fill in and encrypt:
#   cp secrets.env.example secrets.env
#   sops encrypt secrets.env > secrets.enc.env
#   rm secrets.env
#
TUNNEL_TOKEN=<YOUR_TUNNEL_TOKEN>
# Must match redis-server-password in unbound-cachedb.enc.conf
# Generate with: openssl rand -hex 24
REDIS_PASSWORD=<REDIS_PASSWORD>
# The VPS's Cloudflare Mesh IP
VPS_MESH_IP=<VPS_MESH_IP>
